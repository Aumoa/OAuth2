{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "OAuth2": {
    "ClientId": "oauth2"
  },
  "OpenId": {
    "Issuer": "https://localhost:5173",
    "AccessTokenLifetimeMinutes": 30,
    "RefreshTokenLifetimeDays": 30,
    "SigningKeyPath": null
  },
  "RedisOptions": {
    "ConnectionString": "localhost:6379",
    "DbIndex": 0
  },
  "RememberedSessionOptions": {
    "LifetimeDays": 14
  },
  "MySqlOptions": {
    "Server": "localhost",
    "Port": 3306,
    "Database": "OAuth2",
    "User": "root",
    "Password": "root"
  },
  "MigrationOptions": {
    "RunOnStartup": true
  },
  "SESOptions": {
    "SenderAddress": "no-reply@example.com",
    "SenderName": "OAuth2",
    "Region": "us-east-2",
    "VerificationUrl": "https://localhost:5173/verifyEmail",
    "VerificationCodeValidMinutes": 30
  }
}
