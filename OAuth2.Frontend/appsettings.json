{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "RedisOptions": {
    "ConnectionString": "localhost:6379",
    "DbIndex": 0
  },
  "OAuth2": {
    "BackendUrl": "https://localhost:7259",
    "ClientId": "oauth2"
  },
  "SessionOptions": {
    "CookieName": "oauth2_session",
    "LifetimeMinutes": 720
  }
}
